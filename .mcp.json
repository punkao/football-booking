{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "tools/node_modules/@playwright/mcp/cli.js",
        "--isolated",
        "--browser", "chromium",
        "--viewport-size", "1280x800",
        "--output-dir", "screenshots/mcp"
      ],
      "env": { "PLAYWRIGHT_BROWSERS_PATH": "D:/ms-playwright" }
    },
    "excalidraw": {
      "command": "node",
      "args": ["tools/node_modules/mcp-excalidraw-server/dist/bin.js"],
      "env": { "PORT": "8892", "EXPRESS_SERVER_URL": "http://127.0.0.1:8892" }
    },
    "football": {
      "command": "node",
      "args": ["tools/mcp-football/server.mjs"],
      "env": { "FOOTBALL_BASE_URL": "http://localhost:3000" }
    }
  }
}
