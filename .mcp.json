{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "tools/node_modules/@playwright/mcp/cli.js",
        "--isolated",
        "--browser", "chromium",
        "--viewport-size", "1280x800",
        "--output-dir", "screenshots/mcp"
      ],
      "env": { "PLAYWRIGHT_BROWSERS_PATH": "D:/ms-playwright" }
    },
    "excalidraw": {
      "command": "node",
      "args": ["tools/node_modules/mcp-excalidraw-server/dist/bin.js"]
    }
  }
}
