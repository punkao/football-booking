EXCEEDS_TOTAL:{th:\"ใช้เครดิตเกินยอดรวมไม่ได้\",en:\"Credit cannot exceed the total price\",status:400},CREDIT_INSUFFICIENT:{th:\"เครดิตไม่พอ\",en:\"Not enough credit\",status:400},MEMBER_REQUIRED:{th:\"ต้องเข้าสู่ระบบสมาชิกก่อน\",en:\"Please log in as a member first\",status:401},FREE_HOUR_NOT_ELIGIBLE:{th:\"ใช้ชั่วโมงฟรีได้เฉพาะรอบที่เริ่มก่อน 17:00 วันจันทร์–ศุกร์\",en:\"Free hours can only be used for slots starting before 17:00, Monday–Friday\",status:400},FREE_HOUR_NONE:{th:\"ยังไม่มีสิทธิ์ชั่วโมงฟรี\",en:\"You have no free hours yet\",status:400},BOOKING_NOT_FOUND:{th:\"ไม่พบการจอง\",en:\"Booking not found\",status:404},BOOKING_FORBIDDEN:{th:\"เบอร์โทรไม่ตรงกับการจองนี้\",en:\"The phone number does not match this booking\",status:403},INVALID_STATUS:{th:\"สถานะการจองนี้ทำรายการนี้ไม่ได้\",en:\"This action is not allowed for the booking's current status\",status:409},PAYMENT_EXPIRED:{th:\"หมดเวลาชำระเงิน รอบเวลานี้ว่างแล้ว\",en:\"Payment time has expired. The slot is available again\",status:409},CANCEL_TOO_LATE:{th:\"ยกเลิกได้ก่อนเวลาเริ่มเท่านั้น\",en:\"Bookings can only be cancelled before the start time\",status:409},RESCHEDULE_LIMIT:{th:\"เลื่อนได้ 1 ครั้งต่อการจอง\",en:\"A booking can be rescheduled only once\",status:409},RESCHEDULE_TOO_LATE:{th:\"เลื่อนได้เมื่อเหลือเวลาอย่างน้อย 24 ชั่วโมงก่อนเวลาเริ่ม\",en:\"Rescheduling requires at least 24 hours before the start time\",status:409},RESCHEDULE_SAME:{th:\"กรุณาเลือกวันหรือเวลาใหม่ที่ต่างจากเดิม\",en:\"Please choose a different date or time\",status:400},NO_SHOW_TOO_EARLY:{th:\"บันทึกไม่มาได้เมื่อเลยเวลาเริ่มอย่างน้อย 15 นาที\",en:\"No-show can be recorded only 15 minutes after the start time\",status:409},SERIES_WEEKS_RANGE:{th:\"จองประจำได้ 4–12 สัปดาห์\",en:\"Recurring bookings must be 4–12 weeks\",status:400},SERIES_CONFLICT:{th:\"มีสัปดาห์ที่ชน: {dates} กรุณายืนยันจองเฉพาะสัปดาห์ที่ว่าง\",en:\"Some weeks are taken: {dates}. Please confirm booking only the free weeks\",status:409},SERIES_NONE_AVAILABLE:{th:\"ไม่มีสัปดาห์ที่ว่างให้จอง\",en:\"No free weeks to book\",status:409},RAIN_COVERED_FIELD:{th:\"สนาม {field} มีหลังคา ปิดเพราะฝนไม่ได้\",en:\"Field {field} is covered and cannot be closed for rain\",status:400},INVALID_RANGE:{th:\"ช่วงเวลาไม่ถูกต้อง\",en:\"Invalid time range\",status:400},HOLIDAY_EXISTS:{th:\"มีวันหยุดวันนี้อยู่แล้ว\",en:\"This holiday already exists\",status:409},HOLIDAY_NOT_FOUND:{th:\"ไม่พบวันหยุด\",en:\"Holiday not found\",status:404},CHALLENGE_NOT_ALLOWED:{th:\"ประกาศหาคู่แข่งได้เฉพาะการจองที่ยืนยันแล้วและยังไม่ถึงเวลาเริ่ม\",en:\"Only confirmed bookings that have not started can look for an opponent\",status:409},CHALLENGE_EXISTS:{th:\"การจองนี้ประกาศหาคู่แข่งแล้ว\",en:\"This booking already has a challenge\",status:409},CHALLENGE_NOT_FOUND:{th:\"ไม่พบประกาศหาคู่แข่ง\",en:\"Challenge not found\",status:404},CHALLENGE_NOT_OPEN:{th:\"ประกาศนี้ไม่เปิดรับแล้ว\",en:\"This challenge is no longer open\",status:409},CHALLENGE_OWN:{th:\"รับคำท้าของตัวเองไม่ได้\",en:\"You cannot accept your own challenge\",status:409},CHALLENGE_PAYMENT_EXPIRED:{th:\"หมดเวลาชำระเงิน ประกาศกลับมาเปิดรับแล้ว\",en:\"Payment time has expired. The challenge is open again\",status:409},CHALLENGE_MATCHED:{th:\"มีทีมรับคำท้าแล้ว ยกเลิกหรือเลื่อนการจองนี้ไม่ได้\",en:\"A team has accepted the challenge. This booking can't be cancelled or rescheduled\",status:409},CHALLENGE_PENDING:{th:\"มีทีมกำลังชำระเงินรับคำท้า เลื่อนการจองได้หลังชำระเสร็จหรือหมดเวลา 15 นาที\",en:\"A team is paying for the challenge. You can reschedule after they pay or after 15 minutes\",status:409},CHALLENGE_WRONG_PHONE:{th:\"เบอร์โทรไม่ตรงกับทีมที่รับคำท้า\",en:\"The phone number does not match the accepting team\",status:403},TEAM_REQUIRED:{th:\"กรุณากรอกชื่อทีม\",en:\"Please enter a team name\",status:400},INVALID_LEVEL:{th:\"กรุณาเลือกระดับทีม\",en:\"Please choose a team level\",status:400},SPLIT_COUNT:{th:\"จำนวนคนต้องอยู่ระหว่าง 2–30 คน\",en:\"The number of people must be 2–30\",status:400},SPLIT_NOT_FOUND:{th:\"ไม่พบลิงก์หารค่าสนาม\",en:\"Split link not found\",status:404},RETURN_EXCEEDS:{th:\"จำนวนคืนเกินจำนวนที่เช่า\",en:\"Returned quantity exceeds the rented quantity\",status:400},LOGIN_FAILED:{th:\"เบอร์โทรหรือรหัสผ่านไม่ถูกต้อง\",en:\"Incorrect phone number or password\",status:401},STAFF_LOGIN_FAILED:{th:\"ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง\",en:\"Incorrect username or password\",status:401},ALREADY_REGISTERED:{th:\"เบอร์นี้สมัครสมาชิกแล้ว กรุณาเข้าสู่ระบบ\",en:\"This phone number is already registered. Please log in\",status:409},PASSWORD_TOO_SHORT:{th:\"รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร\",en:\"Password must be at least 8 characters\",status:400},UNAUTHORIZED:{th:\"กรุณาเข้าสู่ระบบ\",en:\"Please log in\",status:401},FORBIDDEN_ROLE:{th:\"บทบาทของคุณไม่มีสิทธิ์เข้าถึงส่วนนี้\",en:\"Your role is not allowed to access this\",status:403},NOT_FOUND:{th:\"ไม่พบข้อมูล\",en:\"Not found\",status:404},INTERNAL:{th:\"เกิดข้อผิดพลาดในระบบ กรุณาลองใหม่\",en:\"Something went wrong. Please try again\",status:500},NETWORK:{th:\"เชื่อมต่อไม่ได้ กรุณาลองใหม่\",en:\"Connection failed. Please try again\",status:0},FORBIDDEN_ORIGIN:{th:\"คำขอนี้ต้องส่งจากหน้าเว็บของร้านเท่านั้น\",en:\"This request must come from the shop's own website\",status:403},STOCK_ITEM_NOT_FOUND:{th:\"ไม่พบของในคลัง\",en:\"Stock item not found\",status:404},INVALID_LOCATION:{th:\"ที่เก็บไม่ถูกต้อง\",en:\"Invalid storage place\",status:400},STOCK_INSUFFICIENT:{th:\"ของไม่พอ ({item} มี {available})\",en:\"Not enough stock ({item}: {available} available)\",status:409},STOCK_SAME_LOCATION:{th:\"ต้นทางและปลายทางต้องเป็นคนละที่\",en:\"Source and destination must be different places\",status:400},STOCK_NOT_FOR_SALE:{th:\"ขายได้เฉพาะของหมวดของขาย ({item} ขายไม่ได้)\",en:\"Only sale items can be sold ({item} cannot be sold)\",status:400},STOCK_RESERVED:{th:\"ลดไม่ได้ การจองที่ยังไม่จบจอง{item}ไว้ {reserved} ชิ้น\",en:\"Cannot reduce: bookings that have not ended hold {reserved} of {item}\",status:409},STOCK