# copy to web/.env (not in git · NFR-18). The password must match db/.env.
DATABASE_URL=postgres://football:CHANGE_ME@football-db:5432/football
# 1 only on a test machine (NFR-21) · 0 in production
ALLOW_TEST_RESET=0
BUG_MODE=0
# mock = rule-based chatbot, no network · ai = OpenAI-compatible gateway (NFR-15)
MODE=mock
LLM_BASE_URL=http://host.docker.internal:8004/v1
LLM_MODEL=claude
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
# signs cookies and the chat draftToken: set a long random value
SESSION_SECRET=
