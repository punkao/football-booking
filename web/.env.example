# copy to web/.env (not in git · NFR-18). The password must match db/.env.
DATABASE_URL=postgres://football:CHANGE_ME@football-db:5432/football
# 1 only on a test machine (NFR-21) · 0 in production
ALLOW_TEST_RESET=0
BUG_MODE=0
# mock = rule-based chatbot, no network · ai = OpenAI-compatible gateway (NFR-15)
MODE=mock
LLM_BASE_URL=http://host.docker.internal:8004/v1
LLM_MODEL=claude
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
# REQUIRED (R1): signs the login cookies, chat confirmation cards and back-office chat references.
# At least 32 random characters, never an example value. The web refuses to start without it
# (only a test machine with ALLOW_TEST_RESET=1 may leave it empty: a random secret is then used for that run).
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# mock-llm (compose profile "mock") answers only this Bearer token: set the same value as LLM_API_KEY when MODE=ai
# with LLM_BASE_URL=http://mock-llm:8080/v1 (make it the same way as SESSION_SECRET)
MOCK_LLM_TOKEN=
